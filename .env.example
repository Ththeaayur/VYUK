# Google Gemini API Key (Get yours from https://aistudio.google.com/)
GEMINI_API_KEY=

# Assistant Personality & Model Configuration
ASSISTANT_NAME=VYUK
VOICE_NAME=Aoede
# MODEL_NAME is the Gemini LIVE (voice) model — it must be a Live
# model; plain text models (e.g. gemini-2.5-flash) cannot hold a voice
# session, and the retired gemini-2.0 line is rejected outright.
# Options: gemini-live-2.5-flash-native-audio,
# gemini-3.8-live (GA; chain head since v5.54 — the preview ids
# retire 17 Nov 2026). Fallbacks live in core/live_client.py.
MODEL_NAME=gemini-3.8-live

# Audio Configuration
SAMPLE_RATE_IN=16000
SAMPLE_RATE_OUT=24000
CHANNELS=1
CHUNK_SIZE=1024

# Session provenance lock (v5.48; was "speaker lock" before the
# rename): when true, spoken requests that would change the
# computer need confirmation unless you started this session from
# the app. It is a session lock, not voiceprint verification.
# Legacy alias: SPEAKER_LOCK is still honoured when
# SESSION_PROVENANCE_LOCK is not set.
SESSION_PROVENANCE_LOCK=false
