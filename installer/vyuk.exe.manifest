<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- VYUK application manifest — Wave 10 (v5.65) Leaf 1, UI-48a/b.

     The load-bearing line is <dpiAwareness>PerMonitorV2</dpiAwareness>:
     it is the frozen-exe half of the DPI stack. The source-side half
     (main.py asking Windows for PER_MONITOR_AWARE_V2 before Qt is
     imported) shipped in v5.54; a frozen exe without this manifest
     would still be bitmap-stretched on 125%/150% displays, because
     Windows reads awareness from the manifest first.

     The legacy <dpiAware>true</dpiAware> line is kept beside it for
     older Windows (8.1 / early 10): on systems that understand
     dpiAwareness, the PerMonitorV2 value wins; on older ones, the
     legacy line still gives system-aware behaviour instead of
     unaware stretching.

     This file is NOT embedded by PyInstaller. The Windows build
     embeds it with mt.exe AFTER the freeze (see
     WINDOWS_BUILD_CHECKLIST.md step 4) and then re-checks the
     embedded manifest with installer/dpi_gate.py in exe mode.

     assemblyIdentity version "6.3.0.0" tracks core/version.py
     VERSION ("6.3.0"); the fourth component is the Windows
     manifest's required build number, not a product version bump.
     The supportedOS GUIDs below are Microsoft's published values.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity version="6.3.0.0" processorArchitecture="*" name="VYUK" type="win32"/>
  <description>VYUK voice assistant</description>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 8 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
